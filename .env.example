# Copy to .env.local for local work. Real values live only in Vercel and GitHub settings.

# Root domain that tenants hang off: {slug}.ROOT_DOMAIN. Local: localhost:3000
ROOT_DOMAIN=localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Scratch Postgres for `npm run test:db` (optional locally; the script starts one if unset)
DATABASE_URL=

# Shown in the privacy policy and terms (/privacy, /terms). Not secret.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
LEGAL_COUNTRY=

# Website contact form (optional). Requests are always stored and listed in Admin → Inbox; with a
# Resend key they are also emailed to CONTACT_TO_EMAIL (or LEGAL_CONTACT_EMAIL). SERVER ONLY.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Until you verify a domain in Resend, leave empty: it sends from onboarding@resend.dev, which only
# delivers to the email address of your own Resend account.
CONTACT_FROM_EMAIL=
# The support address: people who write through /support get a confirmation from it, and our
# replies come from it (default support@sessional.app). Sign-up links and invitations keep coming
# from CONTACT_FROM_EMAIL. Its domain must be verified in Resend. Not secret.
SUPPORT_EMAIL=

# Schools' own domains (optional, Phase 15): a Vercel token and this project's id (and team id if
# the project belongs to a team). Without them, Owner → Domains says domains aren't connected yet.
# SERVER ONLY.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# The "are you a person" check on public forms (Cloudflare Turnstile). Optional.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
