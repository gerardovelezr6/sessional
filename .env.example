# Copy to .env.local for local work. Real values live only in Vercel and GitHub settings.

# Root domain that tenants hang off: {slug}.ROOT_DOMAIN. Local: localhost:3000
ROOT_DOMAIN=localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Scratch Postgres for `npm run test:db` (optional locally; the script starts one if unset)
DATABASE_URL=
