{
  "name": "sessional",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/db-test.sh",
    "test:e2e": "playwright test",
    "schema:build": "node scripts/build-schema.mjs",
    "schema:check": "node scripts/build-schema.mjs --check",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run schema:check && npm run check:secrets && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
